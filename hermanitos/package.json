{
  "name": "hermanitos-card",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8791",
    "check": "node --check worker/index.js && node --check public/hermanitos/assets/app.js",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node scripts/vendor.mjs && wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4",
    "wrangler": "4.131.1",
    "miniflare": "5.20260911.0-alpha"
  }
}
