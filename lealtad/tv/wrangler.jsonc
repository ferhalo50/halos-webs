{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "renace-cafe-tv",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "renacecafetv.haloswebs.com", "custom_domain": true }
  ]
}
