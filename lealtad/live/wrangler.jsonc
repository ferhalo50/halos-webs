{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "renace-lealtad",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renace-lealtad",
      "database_id": "68cad595-dbc5-4e6a-b3e0-d52cb6a05d6e",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_TIMEZONE": "America/Tijuana",
    "SESSION_DAYS": "30"
  },
  "triggers": {
    "crons": ["17 10 * * *"]
  }
}
