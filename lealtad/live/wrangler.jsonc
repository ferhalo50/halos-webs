{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lealtad",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sistema-lealtad",
      "database_id": "9648ba79-12f2-4ae8-a1b3-22ce25b57e7c",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "MAINTENANCE_MODE": "OFF",
    "APP_TIMEZONE": "America/Tijuana",
    "SESSION_DAYS": "30"
  },
  "triggers": {
    "crons": ["17 10 * * *"]
  },
  "routes": [
    { "pattern": "mooncoffee.haloswebs.com", "custom_domain": true },
    { "pattern": "renacecafe.haloswebs.com", "custom_domain": true },
    { "pattern": "santofe.haloswebs.com", "custom_domain": true },
    { "pattern": "vainillacoffee.haloswebs.com", "custom_domain": true },
    { "pattern": "app.haloswebs.com/renace", "zone_name": "haloswebs.com" },
    { "pattern": "app.haloswebs.com/renace/*", "zone_name": "haloswebs.com" }
  ]
}
